# -----------------------------------------------------------------------------
# Argaman CRM — environment variables (example; no real secrets here)
# Copy to .env.local for local development. On Vercel: Project → Settings →
# Environment Variables, then redeploy (new variables only apply to new deployments).
# -----------------------------------------------------------------------------

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# -----------------------------------------------------------------------------
# Green Invoice (Morning) — optional. Without the key ID + secret the integration
# is off and the UI shows "Green Invoice לא מחובר — הגדרות".
# Create keys in Green Invoice: הגדרות ← כלי מפתחים ← מפתחות API.
# The sandbox (https://sandbox.d.greeninvoice.co.il) has its own account and keys.
# -----------------------------------------------------------------------------

# API key ID (OAuth client_id, a UUID)
GREEN_INVOICE_API_KEY_ID=
# API key secret (OAuth client_secret). Server-only — never prefix with NEXT_PUBLIC_.
GREEN_INVOICE_API_KEY_SECRET=
# 'sandbox' (default) or 'production'. Production is used ONLY when set explicitly.
GREEN_INVOICE_ENV=sandbox

# Optional overrides (testing / proxies). Leave empty to use the official hosts:
#   production: API https://api.greeninvoice.co.il/api/v1
#               token https://api.morning.co/idp/v1/oauth/token
#               file upload https://api.morning.co/file-upload/v1/url
#   sandbox:    API https://sandbox.d.greeninvoice.co.il/api/v1
#               token https://api.sandbox.morning.dev/idp/v1/oauth/token
#               file upload https://api.sandbox.d.greeninvoice.co.il/file-upload/v1/url
#               (if that host is unreachable, https://api.sandbox.morning.dev/file-upload/v1/url
#                answers the same way)
GREEN_INVOICE_API_URL=
GREEN_INVOICE_AUTH_URL=
GREEN_INVOICE_UPLOAD_URL=
